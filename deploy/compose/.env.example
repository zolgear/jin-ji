# deploy/compose/.env の雛形。コピーして値を変えること（.env はコミットしない）。
#   cp deploy/compose/.env.example deploy/compose/.env
#
# このファイルは docker compose と scripts/dotnet.sh（docker run --env-file）の両方が読む。
# docker run の --env-file は引用符を解釈しないため、値を引用符で囲まないこと。

# PostgreSQL のスーパーユーザー（postgres）。テストで一時データベースを作るときにも使う
JINJI_PG_ADMIN_PASSWORD=change-me-admin

# マイグレーション・テーブル所有者ロール（jinji_owner）
JINJI_PG_OWNER_PASSWORD=change-me-owner

# アプリ用ロール（jinji_app）。テーブル所有者にはしない
JINJI_PG_APP_PASSWORD=change-me-app

# ホストに公開するポート（127.0.0.1 のみ）
JINJI_PG_HOST_PORT=25432
