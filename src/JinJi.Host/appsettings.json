{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JinJi": {
    "Directory": {
      "RetiredPublicDays": 90
    },
    "OrgSnapshotCache": {
      "VersionCheckInterval": "00:00:05",
      "MaxAge": "00:10:00"
    },
    "Llm": {
      "Enabled": false,
      "Provider": "openai",
      "BaseUrl": "https://api.openai.com/v1",
      "ApiKeyEnvironmentVariable": "OPENAI_API_KEY",
      "AllowedEndpoints": [ "https://api.openai.com/v1" ]
    },
    "Mcp": {
      "Enabled": true
    },
    "Sync": {
      "DirectApply": {
        "Enabled": false
      }
    },
    "Auth": {
      "Server": {
        "Cimd": {
          "AllowedDomains": [ "claude.ai", "chatgpt.com", "vscode.dev" ]
        }
      }
    }
  }
}
